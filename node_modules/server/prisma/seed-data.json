  "pages": [
    {
      "id": "cmscx7bqq000ovgxok0b64dpt",
      "spaceId": "cmscx7bqg000avgxoffz6zcqy",
      "parentId": null,
      "title": "Welcome",
      "slug": "welcome",
      "content": "# Welcome to Mplus Admin UserManual Wiki\n\nThis is a **sample frame** for your wiki-style user manual page. \n\n\n## Features in System as a Admin \n\n- Organize docs into **Spaces** (like Docmost / Confluence)\n- Nest pages in a sidebar tree\n- Switch editors per page: Markdown, WYSIWYG, or HTML\n- Control access with roles, groups, and page permissions\n- Toggle light / dark mode\n\n\n## Features in System as a Editor\n\n- Create/Edit/Preview/Publish page in existing Spaces\n- Switch editors per page: Markdown, WYSIWYG, or HTML\n- Toggle light / dark mode\n\n\n## Features in System as a Viewer\n\n- View pages in all Spaces\n- Toggle light / dark mode\n\n\n## Demo accounts\n\n| Role   | Username | Password   |\n|--------|----------|------------| \n| Editor | editor   | editor123  |\n| Viewer | viewer   | viewer123  |\n",
      "editorType": "MARKDOWN",
      "published": true,
      "order": 0,
      "authorId": "cmscx7bpw0000vgxo1it83kah",
      "createdAt": "2026-08-03T07:41:18.771Z",
      "updatedAt": "2026-08-03T08:17:31.741Z"
    },
    {
      "id": "cmscx7bqt000qvgxougfcqjv2",
      "spaceId": "cmscx7bqg000avgxoffz6zcqy",
      "parentId": "cmscx7bqq000ovgxok0b64dpt",
      "title": "Quick Start",
      "slug": "quick-start",
      "content": "# Quick Start\n\n1. Sign in as admin/editor role\n2. Create/Open a Space\n3. Add nested pages\n4. Publish for readers\n\nYou as Admin/ Editor can customize page later with your desired editor format.\n",
      "editorType": "MARKDOWN",
      "published": true,
      "order": 0,
      "authorId": "cmscx7bpw0000vgxo1it83kah",
      "createdAt": "2026-08-03T07:41:18.773Z",
      "updatedAt": "2026-08-03T08:13:03.769Z"
    },
    {
      "id": "cmscx7bqu000svgxoeiqrl92w",
      "spaceId": "cmscx7bqg000avgxoffz6zcqy",
      "parentId": null,
      "title": "Installation",
      "slug": "installation",
      "content": "# Project Installation\n\nInstallation guide.\n\n```bash\ndocker compose up -d\nnpm install\nnpm run db:push\nnpm run db:seed\nnpm run dev\n```\n",
